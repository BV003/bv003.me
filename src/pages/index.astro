---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts, toPostList } from '../utils/posts';

const sortedPosts = toPostList(await getPublishedPosts());
---

<Layout title="Blog - Michael Liu">
  <Header />
  
  <main style="max-width: 680px; margin: 0 auto; padding: 1rem 1.5rem 3rem;">
    {sortedPosts.length === 0 ? (
      <p style="color: #666;">No posts yet. Check back soon!</p>
    ) : (
      <div>
        {sortedPosts.map((post) => (
          <PostCard
            title={post.data.title}
            slug={post.data.slug}
            pubDate={post.data.pubDate}
            readingTime={post.readingTime}
            pinned={post.data.pinned}
          />
        ))}
      </div>
    )}
  </main>
</Layout>
