---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, toPostList } from '../../utils/posts';
import { TAGS } from '../../consts';

export async function getStaticPaths() {
  return TAGS.map((tag) => ({
    params: { tag: tag.toLowerCase() },
    props: { tag },
  }));
}

const { tag } = Astro.props;

const posts = toPostList(
  (await getPublishedPosts()).filter((post) => post.data.tags.includes(tag)),
);
---

<Layout title={`${tag} - Michael Liu`} description={`Michael Liu's posts about ${tag.toLowerCase()}.`}>
  <Header />
  
  <main style="max-width: 680px; margin: 0 auto; padding: 1rem 1.5rem 3rem;">
    <div style="margin-bottom: 2rem;">
      <a href="/" style="text-decoration: none; color: #666; font-size: 0.875rem;">← Back to all posts</a>
    </div>
    
    <h1 class="tag-title">
      {tag}
    </h1>
    
    {posts.length === 0 ? (
      <p style="color: #666;">No posts found with this tag.</p>
    ) : (
      <div>
        {posts.map((post) => (
          <PostCard
            title={post.data.title}
            slug={post.data.slug}
            pubDate={post.data.pubDate}
            readingTime={post.readingTime}
            pinned={post.data.pinned}
          />
        ))}
      </div>
    )}
  </main>
</Layout>

<style>
  .tag-title {
    margin-bottom: 1.5rem;
    color: var(--color-accent);
  }
</style>
