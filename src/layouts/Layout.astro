---
export interface Props {
  title: string;
  description?: string;
}

const { title, description = "Michael Liu's personal blog" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/profile.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/rss.xml" />
    <!-- KaTeX CSS for math rendering -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous">
    <title>{title}</title>
    <style is:global>
      :root {
        --color-text: #000;
        --color-bg: #fff;
        --color-border: #e5e5e5;
      }
      
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      html {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        font-size: 16px;
        line-height: 1.6;
        color: var(--color-text);
        background: var(--color-bg);
        -webkit-font-smoothing: antialiased;
      }
      
      body {
        min-height: 100vh;
      }
      
      a {
        color: var(--color-text);
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      
      a:hover {
        text-decoration: none;
      }
      
      /* Beautiful Typography Hierarchy */
      h1, h2, h3, h4, h5, h6 {
        font-weight: 700;
        line-height: 1.2;
        letter-spacing: -0.02em;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
      }
      
      h1 {
        font-size: 2.5rem;
        margin-top: 0;
        margin-bottom: 1.5rem;
        letter-spacing: -0.03em;
      }
      
      h2 {
        font-size: 1.875rem;
        margin-top: 3rem;
        margin-bottom: 1.25rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--color-border);
      }
      
      h3 {
        font-size: 1.25rem;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
      }
      
      h4 {
        font-size: 1.25rem;
        margin-top: 2rem;
        margin-bottom: 0.875rem;
      }
      
      h5 {
        font-size: 1.125rem;
        margin-top: 1.75rem;
        margin-bottom: 0.75rem;
      }
      
      h6 {
        font-size: 1rem;
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 600;
      }
      
      p {
        margin-bottom: 1.25rem;
        line-height: 1.75;
      }
      
      /* First paragraph after heading */
      h1 + p, h2 + p, h3 + p, h4 + p, h5 + p, h6 + p {
        margin-top: 0;
      }
      
      ul, ol {
        margin-bottom: 1.5rem;
        margin-top: 1rem;
        padding-left: 1.75rem;
      }

      ol {
        list-style-type: decimal;
      }
      
      li {
        margin-bottom: 0.5rem;
        line-height: 1.7;
      }
      
      li > ul, li > ol {
        margin-top: 0.5rem;
        margin-bottom: 0.5rem;
      }
      
      code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Courier New', monospace;
        font-size: 0.875em;
        background: #f1f5f9;
        color: #334155;
        padding: 0.2rem 0.4rem;
        border-radius: 4px;
        border: 0px solid #e2e8f0;
      }
      
      pre {
        background: #1e293b;
        padding: 1.25rem;
        border-radius: 12px;
        overflow-x: auto;
        margin: 1.5rem 0;
        position: relative;
        box-shadow: 
          0 4px 6px -1px rgba(0, 0, 0, 0.1),
          0 2px 4px -1px rgba(0, 0, 0, 0.06);
      }
      
      pre code {
        background: none;
        padding: 0;
        color: #e2e8f0;
        font-size: 0.875em;
        line-height: 1.7;
      }

      pre::before {
        content: '';
        display: block;
        width: 60px;
        height: 12px;
        background-image: radial-gradient(circle, #ff5f56 5px, transparent 6px),
                          radial-gradient(circle, #ffbd2e 5px, transparent 6px),
                          radial-gradient(circle, #27c93f 5px, transparent 6px);
        background-position: -20px 0, 0px 0, 20px 0;
        background-repeat: no-repeat;
        margin-bottom: 0.75rem;
        opacity: 0.8;
      }

      /* Override Shiki colors - remove red and yellow */
      pre code span[style*="#F97583"] {
        color: #7dd3fc !important;
      }

      pre code span[style*="#79B8FF"] {
        color: #a5b4fc !important;
      }
      
      blockquote {
        border-left: 3px solid var(--color-text);
        padding: 0.5rem 0 0.5rem 1.5rem;
        margin: 2rem 0;
        font-style: italic;
        color: #444;
        background: #fafafa;
        border-radius: 0 4px 4px 0;
      }
      
      blockquote p {
        margin-bottom: 0.75rem;
      }
      
      blockquote p:last-child {
        margin-bottom: 0;
      }
      
      hr {
        border: none;
        border-top: 1px solid var(--color-border);
        margin: 3rem 0;
      }
      
      img {
        max-width: 100%;
        height: auto;
      }



      /* KaTeX adjustments for clean look */
      .katex {
        font-size: 1em;
      }
      
      .katex-display {
        margin: 1.5rem 0;
        overflow-x: auto;
        overflow-y: hidden;
      }

      /* Footnote styles */
      .footnote-ref {
        vertical-align: super;
        font-size: 0.75em;
        line-height: 0;
      }
      
      .footnote-ref a {
        text-decoration: none;
        padding: 0 2px;
      }
      
      .footnote-backref {
        text-decoration: none;
        margin-left: 0.5rem;
      }
      
      .footnotes {
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px solid var(--color-border);
        font-size: 0.9em;
      }
      
      .footnotes ol {
        padding-left: 1.5rem;
        list-style-type: decimal;
      }
      
      .footnotes li {
        margin-bottom: 0.75rem;
        list-style-type: decimal;
      }
      
      .footnotes li::marker {
        font-weight: 500;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
