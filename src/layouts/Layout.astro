---
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Michael Liu's personal blog - AI research, engineering, and more." />
    <link rel="icon" type="image/png" href="/profile.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/rss.xml" />
    <!-- KaTeX CSS for math rendering -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous">
    <title>{title}</title>
    <style is:global>
      :root {
        --color-text: #111;
        --color-bg: #fffff8;
        --color-border: #c8c5bc;
        --color-accent: #a00000;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      html {
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 16px;
        line-height: 1.45;
        color: var(--color-text);
        background: var(--color-bg);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      
      body {
        min-height: 100vh;
      }
      
      a {
        color: var(--color-accent);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      h1, h2, h3, h4, h5, h6 {
        font-weight: 400;
        line-height: 1.15;
        letter-spacing: 0;
        margin-top: 1.9rem;
        margin-bottom: 0;
      }
      
      h1 {
        font-size: 2.35rem;
        margin-top: 1.5rem;
        margin-bottom: 1.5rem;
      }
      
      h2 {
        font-size: 1.95rem;
        margin-top: 2rem;
      }
      
      h3 {
        font-size: 1.65rem;
        font-style: italic;
        margin-top: 2.2rem;
      }
      
      h4 {
        font-size: 1.25rem;
      }
      
      h5 {
        font-size: 1.125rem;
        margin-top: 1.75rem;
        margin-bottom: 0.75rem;
      }
      
      h6 {
        font-size: 1rem;
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 600;
      }
      
      p {
        margin: 1.1rem 0;
        font-size: 1.1rem;
        line-height: 1.6;
        text-align: justify;
      }
      
      /* First paragraph after heading */
      h1 + p, h2 + p, h3 + p, h4 + p, h5 + p, h6 + p {
        margin-top: 0;
      }
      
      ul, ol {
        margin: 1.1rem 0;
        padding-left: 1.5rem;
      }

      ol {
        list-style-type: decimal;
      }
      
      li {
        margin-bottom: 0.5rem;
        font-size: 1.1rem;
        line-height: 1.6;
        text-align: justify;
      }
      
      li > ul, li > ol {
        margin-top: 0.5rem;
        margin-bottom: 0.5rem;
      }
      
      code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Courier New', monospace;
        font-size: 0.85em;
        background: #fffef8;
        color: #222;
        padding: 0.1rem 0.25rem;
        border-radius: 4px;
      }
      
      pre {
        background: #fffef8;
        padding: 0.6rem;
        border: 1px solid #999;
        border-radius: 4px;
        overflow-x: auto;
        margin: 1.4rem 0;
        position: relative;
      }
      
      pre code {
        background: none;
        padding: 0;
        color: #111;
        font-size: 0.85em;
        line-height: 1.42;
      }



      /* Override Shiki colors - remove red and yellow */
      pre code span[style*="#F97583"] {
        color: #7dd3fc !important;
      }

      pre code span[style*="#79B8FF"] {
        color: #a5b4fc !important;
      }
      
      blockquote {
        border-left: 3px solid var(--color-accent);
        padding: 0.5rem 0 0.5rem 1.25rem;
        margin: 1.8rem 0;
        font-style: italic;
        color: #333;
      }
      
      blockquote p {
        margin-bottom: 0.75rem;
      }
      
      blockquote p:last-child {
        margin-bottom: 0;
      }
      
      hr {
        border: none;
        border-top: 1px solid var(--color-border);
        margin: 3rem 0;
      }
      
      img {
        max-width: 100%;
        height: auto;
      }

      figure {
        margin: 2rem 0;
      }

      figure img {
        display: block;
        border-radius: 4px;
      }

      figcaption {
        text-align: center;
        font-size: 0.875rem;
        color: #888;
        margin-top: 0.5rem;
      }

      /* Table styles */
      table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin: 1.8rem auto;
        font-size: 0.95rem;
        border-top: 2px solid #333;
        border-bottom: 2px solid #333;
      }

      thead {
        border-bottom: 1px solid #333;
      }

      th {
        padding: 0.55rem 0.5rem;
        text-align: left;
        font-weight: 400;
      }

      td {
        padding: 0.55rem 0.5rem;
        border-bottom: 1px solid #ddd8cc;
        vertical-align: top;
        line-height: 1.5;
      }

      tbody tr:nth-child(odd) {
        background: #fbf7f0;
      }

      tbody tr:last-child td {
        border-bottom: none;
      }



      /* KaTeX adjustments for clean look */
      .katex {
        font-size: 1em;
      }
      
      .katex-display {
        margin: 1.5rem 0;
        overflow-x: auto;
        overflow-y: hidden;
      }

      /* Footnote styles */
      .footnote-ref {
        vertical-align: super;
        font-size: 0.75em;
        line-height: 0;
      }
      
      .footnote-ref a {
        text-decoration: none;
        padding: 0 2px;
      }
      
      .footnote-backref {
        text-decoration: none;
        margin-left: 0.5rem;
      }
      
      .footnotes {
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px solid var(--color-border);
        font-size: 0.9em;
      }
      
      .footnotes ol {
        padding-left: 1.5rem;
        list-style-type: decimal;
      }
      
      .footnotes li {
        margin-bottom: 0.75rem;
        list-style-type: decimal;
      }
      
      .footnotes li::marker {
        font-weight: 500;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
