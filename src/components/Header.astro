---
---

<header class="site-header">
  <nav class="site-nav">
    <a href="/" class="site-title">
      Michael Liu's Blog
    </a>
    <div class="nav-links">
      <!-- Search -->
      <div class="search-wrapper">
        <input
          id="search-input"
          type="text"
          placeholder="Search posts..."
          autocomplete="off"
          class="search-input"
        />
        <div
          id="search-results"
          class="search-results"
        ></div>
      </div>
      <!-- Tags -->
      <div class="tags-wrapper">
        <button 
          id="tags-toggle" 
          class="tags-toggle"
          onclick="document.getElementById('tags-dropdown').style.display = document.getElementById('tags-dropdown').style.display === 'block' ? 'none' : 'block';"
        >
          Tags
        </button>
        <div 
          id="tags-dropdown" 
          class="tags-dropdown"
        >
          <a href="/" class="tag-option">All</a>
          <a href="/tag/tech" class="tag-option">Tech</a>
          <a href="/tag/money" class="tag-option">Money</a>
          <a href="/tag/life" class="tag-option">Life</a>
        </div>
      </div>
      <a href="https://bv003.github.io/" class="nav-link" target="_blank" rel="noopener noreferrer">
        Website
      </a>
      <a href="/rss.xml" class="nav-link" target="_blank" rel="noopener noreferrer">
        RSS
      </a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    padding: 3rem 1.5rem 2rem;
    max-width: 720px;
    margin: 0 auto;
  }

  .site-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .site-title {
    font-size: 1.125rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-accent);
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .search-wrapper {
    position: relative;
  }

  .search-input {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.95rem;
    padding: 0.3rem 0.55rem;
    border: 1px solid #aaa;
    border-radius: 4px;
    outline: none;
    width: 270px;
    color: #111;
    background: #fffef8;
  }

  .search-input::placeholder {
    color: #777;
    font-style: italic;
  }

  .search-input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  .search-results {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    margin-top: 0.5rem;
    background: var(--color-bg);
    border: 1px solid #aaa;
    border-radius: 4px;
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.08);
    z-index: 100;
    max-height: 320px;
    overflow-y: auto;
  }

  :global(.search-result) {
    display: block;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid #e1ddd3;
    color: #111;
    font-size: 0.9rem;
    line-height: 1.3;
  }

  :global(.search-result:last-child) {
    border-bottom: 0;
  }

  :global(.search-result:hover) {
    background: #fbf7f0;
    text-decoration: none;
  }

  :global(.search-result-title) {
    display: inline;
  }

  :global(.search-result-date) {
    display: block;
    margin-top: 0.2rem;
    color: #777;
    font-family: Arial, sans-serif;
    font-size: 0.7rem;
  }

  :global(.search-empty) {
    padding: 0.75rem 1rem;
    color: #777;
    font-size: 0.85rem;
    font-style: italic;
  }

  .tags-wrapper {
    position: relative;
  }

  .tags-toggle {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-accent);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1rem;
    padding: 0;
  }

  .tags-dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-top: 0.5rem;
    background: var(--color-bg);
    border: 1px solid #aaa;
    border-radius: 4px;
    padding: 0.5rem 0;
    min-width: 100px;
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.08);
    z-index: 100;
  }

  .tag-option {
    display: block;
    padding: 0.45rem 1rem;
    color: var(--color-accent);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1rem;
  }

  .tag-option:hover {
    background: #fbf7f0;
    text-decoration: none;
  }

  .nav-link {
    text-decoration: none;
  }

  /* Mobile: stack layout below 600px */
  @media (max-width: 600px) {
    .site-nav {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .nav-links {
      flex-wrap: wrap;
      gap: 0.75rem 1rem;
    }

    .search-input {
      width: 100%;
      max-width: 260px;
    }

    .tags-dropdown {
      left: 0;
      transform: none;
    }
  }
</style>

<script>
  // --- Tags dropdown close on outside click ---
  document.addEventListener('click', function(event) {
    const dropdown = document.getElementById('tags-dropdown');
    const toggle = document.getElementById('tags-toggle');
    const target = event.target as Node;
    if (dropdown && toggle && !dropdown.contains(target) && !toggle.contains(target)) {
      dropdown.style.display = 'none';
    }
  });

  // --- Search ---
  (async function() {
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const results = document.getElementById('search-results');
    if (!input || !results) return;

    let index: { title: string; slug: string; pubDate: string; body: string }[] = [];

    // Fetch the search index once
    try {
      const resp = await fetch('/search-index.json');
      index = await resp.json();
    } catch (e) {
      console.error('Failed to load search index', e);
      return;
    }

    function renderResults(items: typeof index) {
      if (items.length === 0) {
        results.innerHTML = '<div class="search-empty">No posts found</div>';
        results.style.display = 'block';
        return;
      }
      results.innerHTML = items.slice(0, 10).map(p => {
        const date = new Date(p.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
        return `<a href="/blog/${p.slug}" class="search-result"><span class="search-result-title">${escapeHtml(p.title)}</span><span class="search-result-date">${date}</span></a>`;
      }).join('');
      results.style.display = 'block';
    }

    function escapeHtml(s: string) {
      return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    input.addEventListener('input', function() {
      const q = input.value.trim().toLowerCase();
      if (q.length === 0) {
        results.style.display = 'none';
        results.innerHTML = '';
        return;
      }
      const matches = index.filter(p =>
        p.title.toLowerCase().includes(q) || p.body.toLowerCase().includes(q)
      );
      renderResults(matches);
    });

    // Close on outside click
    document.addEventListener('click', function(e) {
      const target = e.target as Node;
      if (!input.contains(target) && !results.contains(target)) {
        results.style.display = 'none';
      }
    });

    // Reopen if input already has text on focus
    input.addEventListener('focus', function() {
      const q = input.value.trim().toLowerCase();
      if (q.length > 0 && index.length > 0) {
        const matches = index.filter(p =>
          p.title.toLowerCase().includes(q) || p.body.toLowerCase().includes(q)
        );
        renderResults(matches);
      }
    });
  })();
</script>
