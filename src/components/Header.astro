---
interface Props {
  current?: 'home' | 'blog';
}

const { current } = Astro.props;
---

<header style="padding: 3rem 1.5rem 2rem; max-width: 720px; margin: 0 auto;">
  <nav style="display: flex; justify-content: space-between; align-items: center;">
    <a href="/" style="font-size: 1.125rem; font-weight: 500; text-decoration: none;">
      Weiqi Liu
    </a>
    <div style="display: flex; gap: 1.5rem;">
      <a href="/" style={current === 'home' ? 'text-decoration: none; font-weight: 500;' : 'text-decoration: none;'}>
        About
      </a>
      <a href="/blog" style={current === 'blog' ? 'text-decoration: none; font-weight: 500;' : 'text-decoration: none;'}>
        Blog
      </a>
      <a href="/rss.xml" style="text-decoration: none;" target="_blank" rel="noopener noreferrer">
        RSS
      </a>
    </div>
  </nav>
</header>
