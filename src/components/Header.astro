---
---

<header style="padding: 3rem 1.5rem 2rem; max-width: 720px; margin: 0 auto;">
  <nav style="display: flex; justify-content: space-between; align-items: center;">
    <a href="/" style="font-size: 1.125rem; font-weight: 500; text-decoration: none;">
      Michael Liu's Blog
    </a>
    <div style="display: flex; gap: 1.5rem; align-items: center;">
      <!-- Search -->
      <div style="position: relative;">
        <input
          id="search-input"
          type="text"
          placeholder="Search posts..."
          autocomplete="off"
          style="font-size: 0.875rem; padding: 0.25rem 0.5rem; border: 1px solid #ccc; border-radius: 4px; outline: none; width:270px; background: transparent;"
        />
        <div
          id="search-results"
          style="display: none; position: absolute; top: 100%; left: 0; right: 0; margin-top: 0.5rem; background: white; border: 1px solid #e5e5e5; border-radius: 4px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); z-index: 100; max-height: 320px; overflow-y: auto;"
        ></div>
      </div>
      <!-- Tags -->
      <div style="position: relative;">
        <button 
          id="tags-toggle" 
          style="background: none; border: none; cursor: pointer; font-size: 1rem; padding: 0; text-decoration: none; color: inherit;"
          onclick="document.getElementById('tags-dropdown').style.display = document.getElementById('tags-dropdown').style.display === 'block' ? 'none' : 'block';"
        >
          Tags
        </button>
        <div 
          id="tags-dropdown" 
          style="display: none; position: absolute; top: 100%; left: 50%; transform: translateX(-50%); margin-top: 0.5rem; background: white; border: 1px solid #e5e5e5; border-radius: 4px; padding: 0.5rem 0; min-width: 100px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); z-index: 100;"
        >
          <a href="/" style="display: block; padding: 0.5rem 1rem; text-decoration: none; color: #000; font-size: 0.875rem;" onmouseover="this.style.backgroundColor='#f5f5f5'" onmouseout="this.style.backgroundColor='transparent'">All</a>
          <a href="/tag/tech" style="display: block; padding: 0.5rem 1rem; text-decoration: none; color: #000; font-size: 0.875rem;" onmouseover="this.style.backgroundColor='#f5f5f5'" onmouseout="this.style.backgroundColor='transparent'">Tech</a>
          <a href="/tag/money" style="display: block; padding: 0.5rem 1rem; text-decoration: none; color: #000; font-size: 0.875rem;" onmouseover="this.style.backgroundColor='#f5f5f5'" onmouseout="this.style.backgroundColor='transparent'">Money</a>
          <a href="/tag/life" style="display: block; padding: 0.5rem 1rem; text-decoration: none; color: #000; font-size: 0.875rem;" onmouseover="this.style.backgroundColor='#f5f5f5'" onmouseout="this.style.backgroundColor='transparent'">Life</a>
        </div>
      </div>
      <a href="https://bv003.github.io/" style="text-decoration: none;" target="_blank" rel="noopener noreferrer">
        Website
      </a>
      <a href="/rss.xml" style="text-decoration: none;" target="_blank" rel="noopener noreferrer">
        RSS
      </a>
    </div>
  </nav>
</header>

<script>
  // --- Tags dropdown close on outside click ---
  document.addEventListener('click', function(event) {
    const dropdown = document.getElementById('tags-dropdown');
    const toggle = document.getElementById('tags-toggle');
    const target = event.target as Node;
    if (dropdown && toggle && !dropdown.contains(target) && !toggle.contains(target)) {
      dropdown.style.display = 'none';
    }
  });

  // --- Search ---
  (async function() {
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const results = document.getElementById('search-results');
    if (!input || !results) return;

    let index: { title: string; slug: string; pubDate: string; body: string }[] = [];

    // Fetch the search index once
    try {
      const resp = await fetch('/search-index.json');
      index = await resp.json();
    } catch (e) {
      console.error('Failed to load search index', e);
      return;
    }

    function renderResults(items: typeof index) {
      if (items.length === 0) {
        results.innerHTML = '<div style="padding: 0.75rem 1rem; color: #999; font-size: 0.8rem;">No posts found</div>';
        results.style.display = 'block';
        return;
      }
      results.innerHTML = items.slice(0, 10).map(p => {
        const date = new Date(p.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
        return `<a href="/blog/${p.slug}" style="display: block; padding: 0.6rem 1rem; text-decoration: none; color: #000; font-size: 0.85rem; border-bottom: 1px solid #f0f0f0;"><span style="font-weight: 500;">${escapeHtml(p.title)}</span><span style="color: #999; font-size: 0.75rem; margin-left: 0.5rem;">${date}</span></a>`;
      }).join('');
      results.style.display = 'block';
    }

    function escapeHtml(s: string) {
      return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    input.addEventListener('input', function() {
      const q = input.value.trim().toLowerCase();
      if (q.length === 0) {
        results.style.display = 'none';
        results.innerHTML = '';
        return;
      }
      const matches = index.filter(p =>
        p.title.toLowerCase().includes(q) || p.body.toLowerCase().includes(q)
      );
      renderResults(matches);
    });

    // Close on outside click
    document.addEventListener('click', function(e) {
      const target = e.target as Node;
      if (!input.contains(target) && !results.contains(target)) {
        results.style.display = 'none';
      }
    });

    // Reopen if input already has text on focus
    input.addEventListener('focus', function() {
      const q = input.value.trim().toLowerCase();
      if (q.length > 0 && index.length > 0) {
        const matches = index.filter(p =>
          p.title.toLowerCase().includes(q) || p.body.toLowerCase().includes(q)
        );
        renderResults(matches);
      }
    });
  })();
</script>
