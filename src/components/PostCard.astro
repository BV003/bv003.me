---
import { formatDate } from '../utils/date';

interface Props {
  title: string;
  slug: string;
  pubDate: Date;
  readingTime?: number;
  pinned?: boolean;
}

const { title, slug, pubDate, readingTime, pinned } = Astro.props;
---

<article style="margin-bottom: 1.5rem;">
  <a href={`/blog/${slug}`} style="text-decoration: none; display: block;">
    <h2 style="font-size: 1.125rem; font-weight: 500; margin-bottom: 0.25rem; line-height: 1.4; color: #000;">
      {pinned && <span style="margin-right: 0.5rem;">📌</span>}{title}
    </h2>
  </a>
  <div style="font-size: 0.8rem; color: #666;">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    {readingTime && (
      <span> · {readingTime} min read</span>
    )}
  </div>
</article>
