---
import { formatDate } from '../utils/date';

interface Props {
  title: string;
  slug: string;
  pubDate: Date;
  readingTime?: number;
  pinned?: boolean;
}

const { title, slug, pubDate, readingTime, pinned } = Astro.props;
---

<article class="post-card">
  <a href={`/blog/${slug}`} class="post-link">
    <h2>
      {pinned && <span style="margin-right: 0.5rem;">📌</span>}{title}
    </h2>
  </a>
  <div class="post-meta">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    {readingTime && (
      <span> · {readingTime} min read</span>
    )}
  </div>
</article>

<style>
  .post-card {
    margin-bottom: 1.5rem;
  }

  .post-link {
    display: block;
  }

  .post-link h2 {
    margin-top: 0;
    margin-bottom: 0.25rem;
    font-size: 1.35rem;
  }

  .post-meta {
    color: #666;
    font-size: 0.85rem;
    font-family: Arial, sans-serif;
  }
</style>
